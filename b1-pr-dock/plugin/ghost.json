{
  "schemaVersion": 3,
  "id": "pr-workbench",
  "name": "PR Dock",
  "description": "按 PR、检查、输出三栏查看 GitHub 待办，打开原始 PR、提交和 CI，并交给 Cindy 排查失败。",
  "whenToUse": "查看我创建的或等待我审阅的 GitHub PR、检查 CI 状态、排查失败检查时使用。",
  "version": "0.1.2",
  "minCindyVersion": "0.1.126",
  "entry": "main.js",
  "command": "pr看板",
  "launch": "on-demand",
  "panel": {
    "title": "PR Dock",
    "html": "panel.html",
    "position": "right"
  },
  "settingsHtml": "settings.html",
  "agent": {
    "tasks": true
  },
  "network": {
    "hosts": [
      "api.github.com"
    ],
    "secrets": [
      {
        "key": "github_token",
        "label": "GitHub Token",
        "source": "gh-cli",
        "hint": "优先使用本机 gh 登录；备用 Token 需要所用仓库的 PR、Checks 和 Commit statuses 读取权限。",
        "url": "https://github.com/settings/tokens",
        "inject": {
          "header": "Authorization",
          "format": "Bearer {value}",
          "hosts": [
            "api.github.com"
          ]
        }
      }
    ]
  },
  "setup": {
    "requires": []
  },
  "tools": [
    {
      "name": "list_prs",
      "description": "读取当前 GitHub 账号创建的或等待其审阅的开放 PR。返回受 API 搜索上限约束的列表及是否有遗漏；不创建 AI 任务。",
      "parameters": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "返回条数，默认 20。"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "inspect_pr",
      "description": "读取一个 GitHub PR 当前提交的检查和失败输出，包含 PR、提交及原始检查链接。当前 Agent 应根据结果继续排查，无需新建任务。",
      "parameters": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "description": "owner/repo 格式。"
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "description": "PR 编号。"
          }
        },
        "required": [
          "repo",
          "number"
        ],
        "additionalProperties": false
      }
    }
  ]
}
